{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Shared compiler rules. Each app/package extends this file and adds its own
  // module system (NodeNext for the API, Bundler for the web app) and outputs.
  "compilerOptions": {
    // Language level: Node 26 and current browsers support ES2024
    "target": "ES2024",
    "lib": ["ES2024"],

    // Type-safety
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,

    // Interop with the tools that transpile file by file (SWC, Vite, Vitest)
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,

    // Hygiene
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "sourceMap": true,

    // Must have
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnusedLabels": false,
    "noUncheckedSideEffectImports": true,
    "allowUnreachableCode": false,
    // Optional
    "noPropertyAccessFromIndexSignature": true,
    "erasableSyntaxOnly": true
  }
}
