.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# OS and editor files
.DS_Store
Thumbs.db
.idea/

# Personal financial data must never be committed.
# Anonymised test fixtures are the only exception.
*.xlsx
*.xls
*.ods
*.csv
*.ofx
!**/fixtures/**