// Ledger core — prototype data model (draft for step 4 review).
//
// Conventions
// - IDs are UUIDv7 generated by the application (time-ordered, created before persistence).
// - Every business table carries `workspace_id` (tenant). Cross-table references use composite
//   foreign keys that include `workspace_id`, so a row can never point into another tenant.
// - Some immutable attributes are copied onto child rows (`operation_type`, `account_kind`) and
//   pinned by composite foreign keys, so CHECK constraints can use them safely.
// - Money: NUMERIC(19,4). The currency lives on the account only; scale per currency is enforced
//   by the domain (EUR = 2 decimals).
// - Business dates are DATE (no time, no time zone). Audit timestamps are TIMESTAMPTZ.
// - Constraints Prisma cannot express (CHECK, partial/expression indexes, deferred triggers) live
//   in hand-written SQL inside the migrations. `prisma db push` must never be used.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Identity & tenancy ────────────────────────────────────────────────────────

/// Authentication data (credentials, sessions) is defined in step 7.
model User {
  id        String   @id @db.Uuid
  email     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships Membership[]

  // Case-insensitive uniqueness: unique index on lower(email) (custom SQL).
  @@map("user")
}

enum MemberRole {
  OWNER

  @@map("member_role")
}

/// Tenant: the unit of data isolation. One member in the prototype, households later.
model Workspace {
  id           String   @id @db.Uuid
  name         String
  baseCurrency String   @default("EUR") @map("base_currency") @db.Char(3)
  timezone     String   @default("Europe/Paris")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships     Membership[]
  accounts        Account[]
  categories      Category[]
  operations      Operation[]
  entries         Entry[]
  lines           Line[]
  checkpoints     Checkpoint[]
  auditEvents     AuditEvent[]
  idempotencyKeys IdempotencyKey[]

  @@map("workspace")
}

model Membership {
  workspaceId String     @map("workspace_id") @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  role        MemberRole
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
  @@map("membership")
}

// ─── Accounts & categories ─────────────────────────────────────────────────────

enum AccountKind {
  CHECKING
  SAVINGS
  INVESTMENT

  @@map("account_kind")
}

model Account {
  id                String      @id @db.Uuid
  workspaceId       String      @map("workspace_id") @db.Uuid
  name              String
  kind              AccountKind
  currency          String      @db.Char(3)
  trackingStartDate DateTime    @map("tracking_start_date") @db.Date
  archivedAt        DateTime?   @map("archived_at") @db.Timestamptz(3)
  version           Int         @default(1)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entries     Entry[]
  checkpoints Checkpoint[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, id, kind]) // target of Entry(workspace_id, account_id, account_kind)
  // Case-insensitive name uniqueness: unique index on (workspace_id, lower(name)) (custom SQL).
  @@map("account")
}

enum CategoryKind {
  INCOME
  EXPENSE

  @@map("category_kind")
}

model Category {
  id          String       @id @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  name        String
  kind        CategoryKind
  archivedAt  DateTime?    @map("archived_at") @db.Timestamptz(3)
  version     Int          @default(1)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lines     Line[]

  @@unique([workspaceId, id])
  @@map("category")
}

// ─── Ledger ────────────────────────────────────────────────────────────────────

enum OperationType {
  TRANSACTION
  TRANSFER
  OPENING
  ADJUSTMENT

  @@map("operation_type")
}

/// Aggregate root of the ledger. Structure per type is checked at COMMIT by a deferred trigger.
model Operation {
  id           String        @id @db.Uuid
  workspaceId  String        @map("workspace_id") @db.Uuid
  type         OperationType
  label        String?
  note         String?
  isFixed      Boolean       @default(false) @map("is_fixed")
  checkpointId String?       @map("checkpoint_id") @db.Uuid
  voidedAt     DateTime?     @map("voided_at") @db.Timestamptz(3)
  voidedBy     String?       @map("voided_by") @db.Uuid
  version      Int           @default(1)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy    String        @map("created_by") @db.Uuid
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy    String        @map("updated_by") @db.Uuid

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  checkpoint Checkpoint? @relation(fields: [workspaceId, checkpointId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  entries    Entry[]
  lines      Line[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, id, type]) // target of Entry/Line(workspace_id, operation_id, operation_type)
  @@index([workspaceId, createdAt])
  @@map("operation")
}

/// Effect of an operation on one account. Balance = SUM(amount) of non-voided entries.
model Entry {
  id            String        @id @db.Uuid
  workspaceId   String        @map("workspace_id") @db.Uuid
  operationId   String        @map("operation_id") @db.Uuid
  operationType OperationType @map("operation_type")
  accountId     String        @map("account_id") @db.Uuid
  accountKind   AccountKind   @map("account_kind")
  date          DateTime      @db.Date
  amount        Decimal       @db.Decimal(19, 4)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  operation Operation @relation(fields: [workspaceId, operationId, operationType], references: [workspaceId, id, type], onDelete: Cascade, onUpdate: NoAction)
  account   Account   @relation(fields: [workspaceId, accountId, accountKind], references: [workspaceId, id, kind], onDelete: NoAction, onUpdate: NoAction)

  @@unique([operationId, accountId]) // a transfer cannot use the same account twice
  @@index([accountId, date])
  @@index([workspaceId, date])
  // Partial unique index: one OPENING per account (custom SQL).
  @@map("entry")
}

/// Budget allocation of a TRANSACTION. SUM(lines.amount) = entry.amount.
model Line {
  id             String        @id @db.Uuid
  workspaceId    String        @map("workspace_id") @db.Uuid
  operationId    String        @map("operation_id") @db.Uuid
  operationType  OperationType @map("operation_type")
  categoryId     String        @map("category_id") @db.Uuid
  amount         Decimal       @db.Decimal(19, 4)
  note           String?
  position       Int
  refundOfLineId String?       @map("refund_of_line_id") @db.Uuid

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  operation  Operation @relation(fields: [workspaceId, operationId, operationType], references: [workspaceId, id, type], onDelete: Cascade, onUpdate: NoAction)
  category   Category  @relation(fields: [workspaceId, categoryId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  // Composite FK including category_id: a linked refund must share the origin's category, and
  // ON UPDATE CASCADE propagates a recategorisation of the origin to its refunds (decision P4).
  refundOf   Line?     @relation("Refund", fields: [workspaceId, refundOfLineId, categoryId], references: [workspaceId, id, categoryId], onDelete: NoAction, onUpdate: Cascade)
  refundedBy Line[]    @relation("Refund")

  @@unique([workspaceId, id, categoryId]) // target of the refund FK
  @@unique([operationId, position])
  @@index([workspaceId, categoryId])
  @@index([refundOfLineId])
  @@map("line")
}

model Checkpoint {
  id              String   @id @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  accountId       String   @map("account_id") @db.Uuid
  date            DateTime @db.Date
  declaredBalance Decimal  @map("declared_balance") @db.Decimal(19, 4)
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy       String   @map("created_by") @db.Uuid

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account     Account     @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  adjustments Operation[]

  @@unique([workspaceId, id])
  @@unique([accountId, date])
  @@map("checkpoint")
}

// ─── Cross-cutting ─────────────────────────────────────────────────────────────

/// Append-only. Written by the application in the same SQL transaction as the change.
model AuditEvent {
  id          String   @id @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  action      String // e.g. "operation.created", "operation.voided"
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id") @db.Uuid
  before      Json?
  after       Json?
  requestId   String?  @map("request_id")
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, entityType, entityId, occurredAt])
  @@map("audit_event")
}

model IdempotencyKey {
  workspaceId    String   @map("workspace_id") @db.Uuid
  key            String
  requestHash    String   @map("request_hash")
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, key])
  @@index([expiresAt])
  @@map("idempotency_key")
}
